---
import Base from '../layouts/Base.astro';
import CodeIcon from '@mui/icons-material/Code';
import DnsIcon from '@mui/icons-material/Dns';
import PsychologyIcon from '@mui/icons-material/Psychology';
import CableIcon from '@mui/icons-material/Cable';
import EmailIcon from '@mui/icons-material/Email';
import LanguageIcon from '@mui/icons-material/Language';
import LinkedInIcon from '@mui/icons-material/LinkedIn';
import GitHubIcon from '@mui/icons-material/GitHub';
---

<Base 
  title="About | Fatahilah Miftahul Rahman" 
  description="Profil Fatahilah Miftahul Rahman — Web Developer, IT Network System Administrator (Juara 1 LKS 2026), dan Praktisi AI Engineering."
>
  <div class="page-header">
    <h1 class="title">Tentang <span class="text-gradient">Saya</span></h1>
    <p class="desc">Web Developer & IT Network System Administrator. Mengembangkan aplikasi web berkinerja tinggi serta merancang sistem server bebas <i>downtime</i>.</p>
  </div>
  
  <div class="about-wrapper">
    <!-- Bio Hero Card -->
    <article class="glass-panel bio-card">
      <p class="bio-text">
        Halo! Saya <strong>Fatahilah Miftahul Rahman</strong>, seorang <strong>Web Developer</strong> dan praktisi <strong>IT Network & System Administration</strong>. Saya berdedikasi membangun aplikasi web modern yang cepat, responsif, dan intuitif, sekaligus mengarsitekturi infrastruktur jaringan server yang stabil dan aman.
      </p>
      <p class="bio-text">
        Sebagai <strong>Web Developer</strong>, saya memfokuskan keahlian pada arsitektur web modern (Astro 5, TypeScript, React, Vanilla CSS Design System) dengan prinsip <i>Zero-JS performance</i>. Di bidang jaringan, saya berpengalaman mengonfigurasi perangkat Cisco, MikroTik, Linux/Windows Server, serta mengintegrasikan otomatisasi <strong>AI Prompt Engineering</strong>.
      </p>
    </article>

    <!-- Core Pillars Grid -->
    <section class="section-container">
      <h2 class="section-title">Fokus & Keahlian Utama</h2>
      <div class="grid-container">
        <!-- Web Development Card -->
        <div class="glass-panel skill-card highlight-card">
          <div class="skill-icon">
            <CodeIcon sx={{ fontSize: '1.5rem', color: 'var(--color-accent)' }} />
          </div>
          <h3>Web Development</h3>
          <p>Pengembangan web modern & cepat (Astro 5, React, TypeScript), UI/UX Design System responsif, serta optimasi performa web.</p>
        </div>

        <!-- Network Infrastructure Card -->
        <div class="glass-panel skill-card">
          <div class="skill-icon">
            <DnsIcon sx={{ fontSize: '1.5rem', color: 'var(--color-accent)' }} />
          </div>
          <h3>IT Network & Server</h3>
          <p>Konfigurasi Cisco (VLAN/OSPF/BGP), MikroTik Gateway, Linux Debian Server (Nginx/HAProxy), & Windows Server ADDS.</p>
        </div>

        <!-- AI & Automation Card -->
        <div class="glass-panel skill-card">
          <div class="skill-icon">
            <PsychologyIcon sx={{ fontSize: '1.5rem', color: 'var(--color-accent)' }} />
          </div>
          <h3>AI Prompt Engineering</h3>
          <p>Rekayasa prompt LLM (System Prompts, Chain-of-Thought) dan otomatisasi skrip shell untuk manajemen sistem presisi.</p>
        </div>

        <!-- Hardware & Fiber Optic Card -->
        <div class="glass-panel skill-card">
          <div class="skill-icon">
            <CableIcon sx={{ fontSize: '1.5rem', color: 'var(--color-accent)' }} />
          </div>
          <h3>Hardware & Cabling</h3>
          <p>Penataan rack server, pengkabelan UTP, penyambungan Fiber Optik (Splicing), serta pengujian instrumen OPM/VFL.</p>
        </div>
      </div>
    </section>

    <!-- Contact Grid Card -->
    <section class="glass-panel contact-card">
      <h2 class="contact-title">Mari Terhubung & Berkolaborasi</h2>
      <p class="contact-desc">Tertarik berdiskusi atau berkolaborasi seputar Web Development, infrastruktur jaringan, atau proyek AI? Hubungi saya melalui saluran berikut:</p>
      
      <div class="contact-grid">
        <a href="mailto:fatahilah.f10@gmail.com" class="contact-item">
          <div class="contact-icon-box">
            <EmailIcon sx={{ fontSize: '1.25rem', color: 'var(--color-accent)' }} />
          </div>
          <div>
            <span class="contact-type">Email</span>
            <span class="contact-val">fatahilah.f10@gmail.com</span>
          </div>
        </a>

        <a href="https://fatah.web.id" target="_blank" rel="noopener noreferrer" class="contact-item">
          <div class="contact-icon-box">
            <LanguageIcon sx={{ fontSize: '1.25rem', color: 'var(--color-accent)' }} />
          </div>
          <div>
            <span class="contact-type">Gerbang Utama</span>
            <span class="contact-val">fatah.web.id</span>
          </div>
        </a>

        <a href="https://www.linkedin.com/in/fatahilah-miftahul-rahman" target="_blank" rel="noopener noreferrer" class="contact-item">
          <div class="contact-icon-box">
            <LinkedInIcon sx={{ fontSize: '1.25rem', color: 'var(--color-accent)' }} />
          </div>
          <div>
            <span class="contact-type">LinkedIn</span>
            <span class="contact-val">Fatahilah Miftahul Rahman</span>
          </div>
        </a>

        <a href="https://github.com/fatahilah-mr" target="_blank" rel="noopener noreferrer" class="contact-item">
          <div class="contact-icon-box">
            <GitHubIcon sx={{ fontSize: '1.25rem', color: 'var(--color-accent)' }} />
          </div>
          <div>
            <span class="contact-type">GitHub</span>
            <span class="contact-val">@fatahilah-mr</span>
          </div>
        </a>
      </div>
    </section>
  </div>
</Base>

<style>
  .page-header {
    margin-bottom: 2.5rem;
    text-align: center;
  }
  .title {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    font-weight: 800;
    margin-bottom: 0.5rem;
  }
  .desc {
    color: var(--color-muted);
    font-size: 1.05rem;
    max-width: 650px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .about-wrapper {
    max-width: 850px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .bio-card {
    padding: 1.75rem 2rem;
  }


  .bio-text {
    font-size: 1.025rem;
    line-height: 1.7;
    margin-bottom: 0.85rem;
    color: var(--color-text);
  }
  .bio-text:last-child {
    margin-bottom: 0;
  }

  /* Section Title */
  .section-title {
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
    color: var(--color-text);
  }

  /* Grid Pillars */
  .grid-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .grid-container {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .skill-card {
    padding: 1.25rem 1.5rem;
    transition: transform var(--transition-normal), border-color var(--transition-normal);
  }
  .skill-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-accent);
  }
  .skill-card.highlight-card {
    border-color: var(--color-accent-muted);
    background: linear-gradient(135deg, var(--glass-bg), var(--color-surface-hover));
  }
  .skill-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.5rem;
  }
  .skill-card h3 {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
    color: var(--color-text);
  }
  .skill-card p {
    font-size: 0.925rem;
    color: var(--color-muted);
    line-height: 1.55;
    margin: 0;
  }

  /* Contact Card & Grid */
  .contact-card {
    padding: 2rem;
    text-align: center;
  }
  .contact-title {
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .contact-desc {
    color: var(--color-muted);
    font-size: 0.975rem;
    max-width: 550px;
    margin: 0 auto 1.5rem auto;
    line-height: 1.5;
  }
  
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
    text-align: left;
  }
  @media (min-width: 640px) {
    .contact-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 1.15rem;
    background: var(--color-surface-hover);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    text-decoration: none;
    transition: all var(--transition-normal);
  }
  .contact-item:hover {
    border-color: var(--color-accent);
    background: var(--glass-bg);
    transform: translateY(-2px);
  }
  .contact-icon-box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .contact-type {
    display: block;
    font-size: 0.775rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }
  .contact-val {
    display: block;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
    word-break: break-all;
  }
</style>
