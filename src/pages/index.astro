---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArrowForwardIcon from '@mui/icons-material/ArrowForward';
import EmailIcon from '@mui/icons-material/Email';
import GitHubIcon from '@mui/icons-material/GitHub';
import LinkedInIcon from '@mui/icons-material/LinkedIn';
import RssFeedIcon from '@mui/icons-material/RssFeed';

const posts = await getCollection('blog');
const projects = await getCollection('projects');

// Sort & limit — hanya artikel bahasa Indonesia
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recentPosts = posts
  .filter(p => p.data.lang === 'id' && !p.data.draft)
  .slice(0, 3);

// Proyek pilihan manual — ubah slug/id di sini untuk mengganti tampilan
const PINNED_PROJECT_SLUGS = [
  'perisai-media-sosial',
  'perisai-ayom-temon',
];
const featuredProjects = PINNED_PROJECT_SLUGS
  .map(baseSlug => projects.find(p => p.slug === `${baseSlug}id` || p.slug === `${baseSlug}.id` || p.id.startsWith(baseSlug)))
  .filter(Boolean);
---

<Base title="fmr.blog | Fatahilah Miftahul Rahman" description="Personal blog dan proyek Fatahilah Miftahul Rahman - IT Network System Administration, Web Development">
  <section class="hero">
    <h1 class="hero-title">
      Fatahilah <span class="text-gradient">Miftahul Rahman</span>
    </h1>
    <p class="hero-desc">
      IT Network &amp; System Administrator dan Web Developer. Blog ini tempat saya menulis tentang apa yang saya pelajari dan bangun.
    </p>
    <div class="hero-actions">
      <a href="/blog" class="btn btn-primary group" style="display:inline-flex; align-items:center;">
        <span>Baca Artikel</span>
        <div class="icon-pill">
          <ArrowForwardIcon sx={{ fontSize: '1rem' }} />
        </div>
      </a>
      <a href="/projects" class="btn btn-secondary group" style="display:inline-flex; align-items:center;">
        <span>Lihat Proyek</span>
        <div class="icon-pill">
          <ArrowForwardIcon sx={{ fontSize: '1rem' }} />
        </div>
      </a>
    </div>
  </section>

  <div class="homepage-layout">
    <!-- Main Content Column (Left ~70%) -->
    <div class="main-content">
      <section class="recent-posts">
        <div class="section-header">
          <h2>Tulisan Terbaru</h2>
          <a href="/blog" class="view-all group" style="display:inline-flex; align-items:center;">
            <span>Lihat Semua</span>
            <div class="icon-pill" style="width:1.5rem; height:1.5rem; margin-left:0.35rem;">
              <ArrowForwardIcon sx={{ fontSize: '0.85rem' }} />
            </div>
          </a>
        </div>
        <div class="cards-list">
          {recentPosts.map(post => <ArticleCard post={post} />)}
        </div>
      </section>

      <section class="featured-projects">
        <div class="section-header">
          <h2>Proyek Pilihan</h2>
          <a href="/projects" class="view-all group" style="display:inline-flex; align-items:center;">
            <span>Lihat Semua</span>
            <div class="icon-pill" style="width:1.5rem; height:1.5rem; margin-left:0.35rem;">
              <ArrowForwardIcon sx={{ fontSize: '0.85rem' }} />
            </div>
          </a>
        </div>
        <div class="cards-grid">
          {featuredProjects.map(proj => <ProjectCard proj={proj} />)}
        </div>
      </section>
    </div>

    <!-- Sidebar Column (Right ~30%) -->
    <aside class="sidebar">
      <!-- Profile Widget -->
      <div class="sidebar-widget glass-panel">
        <h3 class="widget-title">Tentang Penulis</h3>
        <p class="widget-desc">
          Fatahilah Miftahul Rahman — Praktisi IT Network &amp; System Administrator (Juara 1 LKS 2026) dan Web Developer.
        </p>
        <a href="/about" class="sidebar-link">
          <span>Profil Lengkap</span>
          <ArrowForwardIcon sx={{ fontSize: '0.9rem' }} />
        </a>
      </div>


      <!-- Social & Connect Widget -->
      <div class="sidebar-widget glass-panel">
        <h3 class="widget-title">Terhubung</h3>
        <div class="social-links">
          <a href="https://github.com/fatahilah-mr" target="_blank" rel="noopener noreferrer" class="social-item">
            <GitHubIcon sx={{ fontSize: '1.1rem' }} />
            <span>GitHub</span>
          </a>
          <a href="https://www.linkedin.com/in/fatahilah-miftahul-rahman" target="_blank" rel="noopener noreferrer" class="social-item">
            <LinkedInIcon sx={{ fontSize: '1.1rem' }} />
            <span>LinkedIn</span>
          </a>
          <a href="mailto:fatahilah.f10@gmail.com" class="social-item">
            <EmailIcon sx={{ fontSize: '1.1rem' }} />
            <span>Email</span>
          </a>
          <a href="/rss.xml" target="_blank" class="social-item">
            <RssFeedIcon sx={{ fontSize: '1.1rem' }} />
            <span>RSS Feed</span>
          </a>
        </div>
      </div>
    </aside>
  </div>
</Base>

<style>
  .hero {
    min-height: calc(100vh - 8rem);
    min-height: calc(100dvh - 8rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    margin: 0 0 2rem 0;
    padding: 2rem 0;
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
    margin-bottom: 0.75rem;
    font-weight: 800;
  }

  .hero-desc {
    font-size: 1.15rem;
    color: var(--color-muted);
    max-width: 680px;
    margin-bottom: 2.5rem;
    line-height: 1.7;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
  .btn {
    padding: 0.8rem 2rem;
    border-radius: var(--radius-full);
    font-weight: 600;
    white-space: nowrap;
    word-break: keep-all;
    flex-shrink: 0;
    transition: all var(--transition-normal);
  }
  .btn-primary {
    background: var(--color-accent-gradient);
    color: #fff;
    box-shadow: 0 4px 15px var(--color-glow);
  }
  @media (hover: hover) {
    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px var(--color-glow);
      color: #fff;
      text-decoration: none;
    }
  }
  .btn-primary:active {
    transform: translateY(0) scale(0.96);
    box-shadow: 0 4px 15px var(--color-glow);
  }
  .btn-secondary {
    background: var(--color-surface);
    color: var(--color-text);
    border: var(--glass-border);
  }
  @media (hover: hover) {
    .btn-secondary:hover {
      background: var(--color-surface-hover);
      text-decoration: none;
    }
  }
  .btn-secondary:active {
    transform: scale(0.96);
    background: var(--color-surface);
  }
  
  .homepage-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 900px) {
    .homepage-layout {
      grid-template-columns: 1fr 310px;
      gap: 2.5rem;
      align-items: start;
    }
  }

  .main-content {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: sticky;
    top: 5rem;
  }

  .sidebar-widget {
    padding: 1.5rem;
    border-radius: var(--radius-lg, 16px);
  }

  .widget-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .widget-desc {
    font-size: 0.925rem;
    color: var(--color-muted);
    line-height: 1.55;
    margin-bottom: 1rem;
  }

  .sidebar-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-accent);
    transition: transform var(--transition-fast);
  }
  .sidebar-link:hover {
    transform: translateX(3px);
  }

  .skill-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .chip {
    background: var(--color-accent-muted);
    color: var(--color-accent-text);
    border: 1px solid rgba(74, 120, 86, 0.3);
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-full);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .social-links {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .social-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.6rem 0.85rem;
    border-radius: var(--radius-md, 8px);
    background: var(--glass-bg);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: 0.9rem;
    font-weight: 500;
    transition: all var(--transition-fast);
  }
  .social-item:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-text);
    transform: translateX(3px);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 1.75rem;
  }
  .section-header h2 {
    font-size: 1.65rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0;
  }
  .view-all {
    font-size: 0.92rem;
    font-weight: 600;
    transition: color var(--transition-fast);
  }
  
  .cards-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 640px) {
    .cards-grid {
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    }
  }
  
  .home-teasers {
    margin-top: 5rem;
  }
  .teaser-glass {
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg, 16px);
  }
  .teaser-col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .teaser-col .btn {
    white-space: nowrap;
    word-break: keep-all;
    flex-shrink: 0;
    width: max-content;
    max-width: 100%;
  }
  @media (max-width: 767px) {
    .teaser-col {
      align-items: center;
      text-align: center;
    }
  }
  .teaser-col h2 {
    font-size: 1.5rem;
    font-weight: 800;
    margin: 0;
    letter-spacing: -0.02em;
  }
  .teaser-col p {
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0 0 0.5rem 0;
  }
  .teaser-divider {
    height: 1px;
    background: var(--color-border);
    width: 100%;
  }
  @media (min-width: 768px) {
    .teaser-glass {
      flex-direction: row;
      align-items: center;
      gap: 2.5rem;
      padding: 3rem 2.5rem;
    }
    .teaser-col {
      flex: 1;
    }
    .teaser-about {
      text-align: left;
    }
    .teaser-contact {
      text-align: right;
    }
    .teaser-contact .btn {
      align-self: flex-end;
    }
    .teaser-about .btn {
      align-self: flex-start;
    }
    .teaser-divider {
      width: 1px;
      height: 140px;
    }
  }
</style>
