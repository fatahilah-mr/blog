---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import SearchIcon from '@mui/icons-material/Search';
import SearchOffIcon from '@mui/icons-material/SearchOff';

const posts = await getCollection('blog');
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allTags = [...new Set(posts.flatMap(p => p.data.tags || []))];
---

<Base title="Blog | fmr.blog" description="Semua artikel di fmr.blog">
  <div class="page-header">
    <h1 class="title">Artikel <span class="text-gradient">Blog</span></h1>
    <p class="desc">Tulisan, tutorial, dan dokumentasi proses belajar.</p>
    <a href="/" class="back-link">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      Kembali ke Beranda
    </a>
  </div>
  
  <div class="controls-container">
    <div class="search-container">
      <input type="text" id="search-input" placeholder="Cari artikel..." class="search-input" aria-label="Cari artikel" />
      <span class="search-icon">
        <SearchIcon sx={{ fontSize: '1.25rem' }} />
      </span>
    </div>

    <div class="lang-filter" id="lang-filter" role="group" aria-label="Filter bahasa">
      <button class="lang-btn" data-lang="all">Semua</button>
      <button class="lang-btn active" data-lang="id">🇮🇩 ID</button>
      <button class="lang-btn" data-lang="en">🇬🇧 EN</button>
    </div>

    <div class="custom-select-wrapper" id="custom-tag-select">
      <div class="custom-select-trigger" tabindex="0" aria-label="Filter berdasarkan tag">
        <span class="custom-select-value">Semua Kategori</span>
        <input
          type="text"
          class="category-search-input"
          placeholder="Cari kategori..."
          aria-label="Cari kategori"
          autocomplete="off"
        />
        <svg class="select-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>
      <div class="custom-select-options">
        <div class="custom-option active" data-value="all">Semua Kategori</div>
        {allTags.map(tag => (
          <div class="custom-option" data-value={tag}>#{tag}</div>
        ))}
      </div>
    </div>
  </div>
  
  <div class="cards-grid">
    {posts.map(post => <ArticleCard post={post} />)}
  </div>
  
  <div class="empty-state" id="empty-state" style="display: none;">
    <div class="empty-icon-box">
      <SearchOffIcon sx={{ fontSize: '3rem', color: 'var(--color-muted)' }} />
    </div>
    <h3>Tidak ditemukan</h3>
    <p>Coba gunakan kata kunci atau tag lain.</p>
  </div>
</Base>

<style>
  .page-header {
    margin-bottom: 3rem;
    text-align: center;
  }
  .title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin-bottom: 0.5rem;
  }
  .desc {
    color: var(--color-muted);
    font-size: 1.1rem;
    margin-bottom: 1.5rem;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-accent);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-full);
    background: var(--color-accent-muted);
    transition: all var(--transition-fast);
  }
  .back-link:hover {
    background: var(--color-accent);
    color: #fff;
    transform: translateX(-3px);
  }
  .cards-grid {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
  }
  .controls-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    margin: 0 0 3rem 0;
  }
  @media (min-width: 640px) {
    .controls-container {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
    }
  }
  .search-container {
    position: relative;
    flex: 1;
    min-width: 160px;
  }
  .search-input {
    width: 100%;
    padding: 0.8rem 1rem 0.8rem 2.8rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--glass-bg);
    color: var(--color-text);
    font-size: 1rem;
    outline: none;
    transition: all var(--transition-fast);
  }
  .search-input:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 2px rgba(74, 120, 86, 0.2);
  }
  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-muted);
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    line-height: 0;
  }
  
  .custom-select-wrapper {
    position: relative;
    flex-shrink: 0;
    min-width: 200px;
    user-select: none;
  }
  .custom-select-trigger {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 0.8rem 1.2rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--glass-bg);
    color: var(--color-text);
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
    outline: none;
    transition: all var(--transition-fast);
  }
  .custom-select-trigger:focus,
  .custom-select-wrapper.open .custom-select-trigger {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 2px rgba(74, 120, 86, 0.2);
  }
  .select-icon {
    color: var(--color-muted);
    transition: transform var(--transition-fast);
  }
  .custom-select-wrapper.open .select-icon {
    transform: rotate(180deg);
  }
  .custom-select-options {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    right: 0;
    background: var(--glass-bg);
    border: 1px solid var(--color-border);
    border-radius: 1.25rem;
    padding: 0.5rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    z-index: 100;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all var(--transition-fast);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  html.theme-dark .custom-select-options {
    background: rgba(18, 18, 18, 0.85);
  }
  .custom-select-wrapper.open .custom-select-options {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .custom-option {
    padding: 0.8rem 1.2rem;
    font-size: 0.95rem;
    color: var(--color-text);
    cursor: pointer;
    border-radius: 0.75rem;
    margin-bottom: 0.25rem;
    transition: background var(--transition-fast);
  }
  .custom-option:last-child {
    margin-bottom: 0;
  }
  @media (hover: hover) {
    .custom-option:hover {
      background: var(--color-surface-hover);
    }
  }
  .custom-option:active {
    background: var(--color-border);
    transform: scale(0.98);
  }
  .custom-option.active {
    background: var(--color-accent-muted);
    color: var(--color-accent-text);
    font-weight: 600;
  }
  
  /* Lang Filter Pills */
  .lang-filter {
    display: flex;
    gap: 0.35rem;
    flex-shrink: 0;
    align-items: center;
  }
  .lang-btn {
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background: var(--glass-bg);
    color: var(--color-muted);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-fast);
    white-space: nowrap;
  }
  @media (hover: hover) {
    .lang-btn:hover {
      border-color: var(--color-accent);
      color: var(--color-accent-text);
    }
  }
  .lang-btn:active { transform: scale(0.96); }
  .lang-btn.active {
    background: var(--color-accent-muted);
    border-color: var(--color-accent-muted);
    color: var(--color-accent-text);
    font-weight: 600;
  }

  /* Searchable Dropdown */
  .category-search-input {
    display: none;
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: var(--color-text);
    font-size: 0.95rem;
    font-family: inherit;
    min-width: 0;
    width: 100%;
  }
  .custom-select-wrapper.open .custom-select-value { display: none; }
  .custom-select-wrapper.open .category-search-input { display: block; }
  .custom-option.hidden { display: none; }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 4rem 1rem;
    color: var(--color-muted);
  }
  .empty-state svg {
    margin-bottom: 1rem;
    opacity: 0.5;
  }
  .empty-state h3 {
    color: var(--color-text);
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }
  .empty-state p {
    font-size: 1rem;
  }
</style>


<script>
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const cards = document.querySelectorAll('.card-link') as NodeListOf<HTMLElement>;
  const emptyState = document.getElementById('empty-state');

  const customSelectWrapper = document.getElementById('custom-tag-select');
  const customSelectTrigger = customSelectWrapper?.querySelector('.custom-select-trigger');
  const customSelectValue = customSelectWrapper?.querySelector('.custom-select-value');
  const customOptions = customSelectWrapper?.querySelectorAll('.custom-option');
  const categorySearchInput = customSelectWrapper?.querySelector('.category-search-input') as HTMLInputElement;

  let activeTag = 'all';
  let activeLang = 'id';

  function filterCards() {
    const term = searchInput?.value.toLowerCase() || '';
    let hasVisibleCards = false;

    cards.forEach(card => {
      const text = card.textContent?.toLowerCase() || '';
      const tags = card.dataset.tags || '';
      const lang = card.dataset.lang || 'id';

      const matchesSearch = text.includes(term);
      const matchesTag    = activeTag === 'all' || tags.includes(activeTag);
      const matchesLang   = activeLang === 'all' || lang === activeLang;

      if (matchesSearch && matchesTag && matchesLang) {
        card.style.display = '';
        hasVisibleCards = true;
      } else {
        card.style.display = 'none';
      }
    });

    if (emptyState) {
      emptyState.style.display = hasVisibleCards ? 'none' : 'flex';
    }
  }

  // Initial filter on load
  filterCards();

  if (searchInput) {
    searchInput.addEventListener('input', filterCards);
  }

  // Lang filter pills
  const langBtns = document.querySelectorAll('.lang-btn') as NodeListOf<HTMLButtonElement>;
  langBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      activeLang = btn.dataset.lang || 'all';
      langBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      filterCards();
    });
  });

  // Searchable category dropdown
  if (customSelectTrigger && customOptions && customSelectWrapper) {
    customSelectTrigger.addEventListener('click', () => {
      const isOpen = customSelectWrapper.classList.toggle('open');
      if (isOpen && categorySearchInput) {
        categorySearchInput.value = '';
        categorySearchInput.focus();
        customOptions.forEach(opt => opt.classList.remove('hidden'));
      }
    });

    categorySearchInput?.addEventListener('input', () => {
      const term = categorySearchInput.value.toLowerCase();
      customOptions.forEach(opt => {
        const isAll = opt.getAttribute('data-value') === 'all';
        const text  = opt.textContent?.toLowerCase() || '';
        if (isAll || text.includes(term)) {
          opt.classList.remove('hidden');
        } else {
          opt.classList.add('hidden');
        }
      });
    });

    categorySearchInput?.addEventListener('click', e => e.stopPropagation());

    customOptions.forEach(option => {
      option.addEventListener('click', () => {
        activeTag = option.getAttribute('data-value') || 'all';
        if (customSelectValue) customSelectValue.textContent = option.textContent;
        customOptions.forEach(opt => opt.classList.remove('active'));
        option.classList.add('active');
        customSelectWrapper.classList.remove('open');
        if (categorySearchInput) {
          categorySearchInput.value = '';
          customOptions.forEach(opt => opt.classList.remove('hidden'));
        }
        filterCards();
      });
    });

    document.addEventListener('click', e => {
      if (!customSelectWrapper.contains(e.target as Node)) {
        customSelectWrapper.classList.remove('open');
      }
    });
  }
</script>
